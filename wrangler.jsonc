{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "topology-go",
  "main": "./worker/index.js",
  "compatibility_date": "2026-07-01",
  // Better Auth (worker/auth.js) needs AsyncLocalStorage, and one of its
  // modules imports node:crypto.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BADUK_ROOMS",
        "class_name": "BadukRoom"
      },
      {
        "name": "BADUK_ROOM_INDEX",
        "class_name": "BadukLobby"
      }
    ]
  },
  // Accounts and game records (worker/auth.js, worker/records.js). Schema
  // changes are SQL files in migrations/, applied with
  // `wrangler d1 migrations apply topology-go --remote` before deploying.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "topology-go",
      "database_id": "df8b9f1f-93f6-4af5-977b-0c8c212d3f7a",
      "migrations_dir": "migrations"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BadukRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["BadukLobby"]
    }
  ],
  // Per-IP budgets (Workers Rate Limiting; period must be 10 or 60 s). Room
  // creation allocates a Durable Object and a lobby code, so it is the
  // tightest: 10/min covers retries after rare code collisions. HTTP joins
  // (30/min) include lobby clicks, spectating and credential retries;
  // WebSocket upgrades (60/min) cover several tabs plus the client's capped
  // exponential reconnect; lobby reads (120/min) are manual refreshes. The
  // namespace IDs must be unique within the Cloudflare account.
  "ratelimits": [
    {
      "name": "ROOM_CREATE_RATE_LIMITER",
      "namespace_id": "71001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "ROOM_JOIN_RATE_LIMITER",
      "namespace_id": "71002",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "ROOM_SOCKET_RATE_LIMITER",
      "namespace_id": "71003",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "LOBBY_RATE_LIMITER",
      "namespace_id": "71004",
      "simple": { "limit": 120, "period": 60 }
    },
    // Account and session calls; a guest is created once per browser.
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "71005",
      "simple": { "limit": 30, "period": 60 }
    },
    // My games: listing pages, opening, removing and uploading records.
    {
      "name": "RECORD_RATE_LIMITER",
      "namespace_id": "71006",
      "simple": { "limit": 60, "period": 60 }
    },
    // Registering and signing in with a password, on top of the budget
    // above: guessing passwords gets ten tries a minute per address.
    {
      "name": "SIGN_IN_RATE_LIMITER",
      "namespace_id": "71007",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
