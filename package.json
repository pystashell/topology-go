{
  "name": "topology-go",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev:online",
    "dev:ui": "vite",
    "dev:online": "npm run build && npm run db:migrate:local && wrangler dev --port 8787 --var BETTER_AUTH_SECRET:local-development-only-secret-0123456789abcdef",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "test:soak": "node scripts/soak.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/game/**\" --test-coverage-include=\"src/topology/**\" --test-coverage-include=\"src/ai/aiPacing.js\" --test-coverage-include=\"src/view/flipWave.js\" --test-coverage-include=\"src/view/gameMarkers.js\" --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95",
    "test:release": "node --test scripts/release.test.mjs",
    "test:live": "node scripts/live-room-smoke.mjs",
    "deploy": "npm run build && wrangler deploy",
    "release:version": "node scripts/release.mjs version",
    "release:plan": "node scripts/release.mjs plan",
    "release:check": "node scripts/release.mjs check",
    "release:publish": "node scripts/release.mjs publish",
    "release:list": "node scripts/release.mjs list",
    "release:rollback": "node scripts/release.mjs rollback",
    "db:migrate:local": "wrangler d1 migrations apply topology-go --local",
    "db:migrate:remote": "wrangler d1 migrations apply topology-go --remote"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "better-auth": "1.7.13",
    "pako": "^2.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "miniflare": "5.20261012.1-beta",
    "vite": "^8.1.4",
    "wrangler": "4.151.1"
  },
  "overrides": {
    "@tensorflow/tfjs": {
      "argparse": "^2.0.1"
    },
    "undici": "^7.30.1"
  }
}
